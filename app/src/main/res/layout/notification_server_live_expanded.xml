<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded live server panel.

  The dense part is one Canvas-rendered bitmap rather than a stack of
  RemoteViews: notifications cannot host arbitrary views (no custom drawing, no
  Compose), and ProgressBar rows alone cannot express per-core bars, ring
  gauges and a throughput sparkline. The bitmap is drawn from the same palette
  as the in-app screen, and adjustViewBounds keeps its aspect ratio on every
  notification width.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/server_live_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/server_live_subhead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="6dp"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary" />

    <ImageView
        android:id="@+id/server_live_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="@string/server_channel_live" />

    <TextView
        android:id="@+id/server_live_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary" />
</LinearLayout>
